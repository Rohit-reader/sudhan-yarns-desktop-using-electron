{
  "name": "sudhan_desktop",
  "productName": "sudhan_desktop",
  "version": "1.0.1",
  "description": "My Electron application description",
  "main": "src/index.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "echo \"No linting configured\"",
    "dist": "electron-builder",
    "release": "electron-builder --publish always"
  },
  "keywords": [],
  "author": {
    "name": "Rohit-reader",
    "email": "rohitb.24msc@kongu.edu"
  },
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.6",
    "electron-squirrel-startup": "^1.0.1",
    "electron-updater": "^6.8.9",
    "express": "^4.22.2",
    "firebase": "^12.16.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "electron": "^41.10.4",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1"
  },
  "overrides": {
    "@electron/node-gyp": "10.2.0-electron.2",
    "tar": "^7.4.3",
    "tmp": "^0.2.3",
    "undici": "^7.3.0",
    "glob": "^11.0.0",
    "rimraf": "^5.0.10"
  },
  "build": {
    "appId": "com.sudhan.desktop",
    "productName": "Sudhan Desktop",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "files": [
      "src/**/*",
      "common/**/*",
      "package.json",
      "package-lock.json",
      "!python_folders/**/*",
      "!out/**/*",
      "!release/**/*",
      "!*.md",
      "!*.spec",
      "!*.log",
      "!.git/**/*"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend"
      }
    ],
    "afterPack": "scripts/afterPack.js",
    "win": {
      "target": "nsis"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Rohit-reader",
        "repo": "sudhan-yarns-desktop-using-electron"
      }
    ]
  }
}
